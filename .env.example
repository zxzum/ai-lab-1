# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080

# Настройки внешнего LLM-провайдера (OpenRouter API)
# Регистрация и получение API-ключа: https://openrouter.ai/settings/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Модель с надёжным вызовом инструментов (~$0.30 / 1M входных токенов); flash-lite чаще ошибается:
LLM_MODEL=google/gemini-2.5-flash
# Бесплатная альтернатива:
LLM_TIMEOUT_SECONDS=30.0
# Прокси для LLM (по умолчанию используется TELEGRAM_PROXY_URL, если задан)
# LLM_PROXY_URL='socks5://proxy:1080'

# Параметры ограничения истории диалога (контекстного окна)
MAX_HISTORY_MESSAGES=10
MAX_HISTORY_CHARS=4000

# MCP-сервер (лабораторная 2). Источник расписания и часовой пояс задаются только здесь,
# модель и пользователь их менять не могут. По умолчанию используется app/mcp_server/data.
# SCHEDULE_FILE=
SCHEDULE_TIMEZONE=Europe/Moscow
